; Engine configuration file.
config_version=5

[application]

config/name="Slopped"
config/description="Friendslop party game: lobby + chaotic minigames."
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Net="*res://src/core/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

[shader_globals]

sky_ambient={
"type": "color",
"value": Color(0.55, 0.62, 0.8, 1)
}
ground_ambient={
"type": "color",
"value": Color(0.35, 0.3, 0.28, 1)
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="avatars"
3d_physics/layer_3="props_solid"
3d_physics/layer_4="props_light"
3d_physics/layer_5="ragdoll"
